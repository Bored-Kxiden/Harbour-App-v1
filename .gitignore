# dependencies
node_modules/

# the Next build and its static export (Capacitor copies `out` into the APK,
# so both are produced by `npm run sync` and neither belongs in git)
.next/
out/

# the copy of the web build Capacitor keeps inside the Android project.
# Produced by `npm run sync`; app/build.gradle fails with instructions if it
# is missing, rather than letting the app install and open to a blank screen.
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# NOT ignored, though `cap sync` regenerates it: android/capacitor-cordova-android-plugins/.
# app/build.gradle and app/capacitor.build.gradle are in git and both reference
# it unconditionally, so leaving it out made a fresh clone impossible to open in
# Android Studio -- Gradle syncs the moment you open the folder, long before
# anyone has had the chance to run npm.

# Android build output and local machine paths
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.apk
*.aab
*.keystore
*.jks

# keys. The anon key is safe to ship; the service role key must never be here.
.env
.env.local

# editors and OS
.idea/
.vscode/
.DS_Store
*.log

# TypeScript build cache. Rebuilt on every typecheck, and nobody needs it.
tsconfig.tsbuildinfo
