<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Instants (the camera screen) and voice notes both call the web
         getUserMedia() API. Capacitor's WebView answers that call by asking
         Android for CAMERA / RECORD_AUDIO at runtime on its own — see
         BridgeWebChromeClient.onPermissionRequest — but only for a permission
         this manifest has already declared. Undeclared, that runtime request
         is auto-denied with no dialog at all, so both features would fail
         silently on a real phone despite working in every browser preview.
         MODIFY_AUDIO_SETTINGS is a normal permission Android grants on
         install; it rides along with RECORD_AUDIO because the WebView asks
         for both together. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- No READ_CONTACTS here on purpose. Adding somebody from the address
         book goes through ContactsPickerPlugin, which delegates to the
         system Contacts app (ACTION_PICK) instead of reading the address
         book itself — see that file for why. -->
</manifest>
