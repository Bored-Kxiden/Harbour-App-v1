# Copy this file to `.env.local` and fill it in.
#
# Both of these are PUBLIC values: the anon key is designed to ship inside the
# app, and it is safe precisely because row level security is on for every
# table. Anything it can reach, it can only reach as the signed-in user.
#
# The service role key is the opposite: it bypasses RLS entirely. It must never
# appear in this file, in the app, or anywhere in this repository.
#
# Find both under Project Settings > API in the Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=https://nfhijkdownrtftdyyuxm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-the-anon-key-here
